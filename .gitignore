# 비밀 키 — 절대 커밋 금지
.env

# 파이썬 · 환경
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# macOS
.DS_Store

# RAG — 스크립트로 다시 만들 수 있는 파일은 올리지 않는다 (python -m rag.prepare)
# PDF는 재배포가 허용된 두 개만 올리고, 나머지는 rag/download_docs.py가 공식 출처에서 받는다
data/raw/*
!data/raw/.gitkeep
!data/raw/regulation_FDA_expedited_programs_2014.pdf
!data/raw/tech_Jayatunga_AI_drugs_clinical_2024.pdf
data/processed/*
!data/processed/.gitkeep
data/index/*
!data/index/.gitkeep
