# 비밀 키 — 절대 커밋 금지
.env

# 파이썬 · 환경
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# macOS
.DS_Store

# RAG — 스크립트로 다시 만들 수 있는 파일은 올리지 않는다 (python -m rag.prepare)
# 원본 PDF 6개(data/raw)는 모두 올린다 — 받자마자 같은 문서로 실행된다
# 비전 전사 캐시는 올린다 — 새로 받은 사람이 비전 API를 다시 부르지 않고 같은 결과를 얻는다
data/processed/*
!data/processed/.gitkeep
!data/processed/vision/
data/index/*
!data/index/.gitkeep
