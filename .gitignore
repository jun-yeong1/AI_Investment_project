# 비밀 키 — 절대 커밋 금지
.env

# 파이썬 · 환경
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# macOS
.DS_Store

# RAG — 스크립트로 다시 만들 수 있는 파일은 올리지 않는다 (python -m rag.prepare)
# PDF는 재배포가 허용된 것과 공식 출처가 막힌 것(BIO)만 올리고, 나머지는 rag/download_docs.py가 공식 출처에서 받는다
# 비전 전사 캐시는 올린다 — 새로 받은 사람이 비전 API를 다시 부르지 않고 같은 결과를 얻는다
data/raw/*
!data/raw/.gitkeep
!data/raw/regulation_FDA_expedited_programs_2014.pdf
!data/raw/tech_Jayatunga_AI_drugs_clinical_2024.pdf
!data/raw/market_BIO_clinical_success_rates_2021.pdf
data/processed/*
!data/processed/.gitkeep
!data/processed/vision/
data/index/*
!data/index/.gitkeep
# 로그인해야 받는 문서(생명공학연구원)의 전사본은 올리지 않는다
data/processed/vision/tech_KRIBB_*
